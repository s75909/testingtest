    private List<String> getColumnNames(WebDriver driver) {
        List<String> names = new ArrayList<>();
        for (WebElement cell : driver.findElements(By.xpath("//table//tbody//tr//td[1]"))) {
            String t = cell.getText().trim();
            if (!t.isEmpty() && !t.contains("No matching")) names.add(t.split("\n")[0]);
        }
        return names;
    }

    private List<String> getCategoryColumn(WebDriver driver) {
        List<String> cats = new ArrayList<>();
        for (WebElement cell : driver.findElements(By.xpath("//table//tbody//tr//td[4]"))) {
            String t = cell.getText().trim();
            if (!t.isEmpty() && !t.contains("No matching")) cats.add(t);
        }
        return cats;
    }

    /** Returns true if list is sorted. desc=true checks Z→A, false checks A→Z */
    private boolean isSorted(List<String> list, boolean desc) {
        for (int i = 0; i < list.size() - 1; i++) {
            int cmp = list.get(i).compareToIgnoreCase(list.get(i + 1));
            if (desc ? cmp < 0 : cmp > 0) return false;
        }
        return true;
    }
