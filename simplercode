    @Test @Order(11)
    public void sortCustomerListByName() throws Exception {
        System.out.println("=== TS01-TC11: Sort customer list by name ===");
        WebDriver driver = new ChromeDriver();
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));
        try {
            driver.manage().window().maximize();
            loginAndGoTo(driver, wait, "customers");

            List<WebElement> rows = driver.findElements(By.xpath("//table//tbody//tr"));
            assertTrue(rows.size() > 1, "Need at least 2 records to test sorting");

            WebElement nameHeader = wait.until(ExpectedConditions.elementToBeClickable(
                By.xpath("//table//thead//tr//th[contains(text(),'Name')]")));

            // Click once → ascending
            nameHeader.click(); Thread.sleep(2000);
            List<String> asc = getColumnNames(driver);

            // Click again → descending
            nameHeader.click(); Thread.sleep(2000);
            List<String> desc = getColumnNames(driver);

            boolean isAsc  = isSorted(asc,  false);
            boolean isDesc = isSorted(desc, true);

            System.out.println("A-Z sort: " + (isAsc  ? "PASSED ✓" : "FAILED ✗"));
            System.out.println("Z-A sort: " + (isDesc ? "PASSED ✓" : "FAILED ✗"));
            assertTrue(isAsc || isDesc, "Sorting should work in at least one direction");
            System.out.println("✅ TEST PASSED — TS01-TC11");
        } finally { driver.quit(); }
    }

