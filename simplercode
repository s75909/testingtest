    /** Create a fresh driver + wait */
    private WebDriver[] setup() {
        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();
        return new WebDriver[]{ driver };
    }

    /** Login and navigate straight to a page */
    private void loginAndGoTo(WebDriver driver, WebDriverWait wait, String page)
            throws InterruptedException {
        driver.get(BASE_URL);
        wait.until(ExpectedConditions.presenceOfElementLocated(By.id("username"))).sendKeys(USERNAME);
        driver.findElement(By.id("password")).sendKeys(PASSWORD);
        driver.findElement(By.cssSelector("button[type='submit']")).click();
        System.out.println("✓ Logged in");
        wait.until(ExpectedConditions.elementToBeClickable(
            By.xpath("//a[@href='index.php?page=" + page + "']"))).click();
        wait.until(ExpectedConditions.presenceOfElementLocated(
            By.xpath("//h3[contains(text(),'" + capitalize(page) + "')]")));
        Thread.sleep(2000);
        System.out.println("✓ On " + capitalize(page) + " page");
    }

    /** Click New button and wait for Add Customer page */
    private void clickNew(WebDriver driver, WebDriverWait wait) throws InterruptedException {
        wait.until(ExpectedConditions.elementToBeClickable(
            By.xpath("//a[contains(@class,'btn-info') and contains(text(),'New')]"))).click();
        wait.until(ExpectedConditions.presenceOfElementLocated(
            By.xpath("//h3[contains(text(),'Add Customer')]")));
        Thread.sleep(1000);
        System.out.println("✓ On Add Customer page");
    }

    /** Fill and submit the Add Customer form */
    private void fillAndSubmitCustomer(WebDriver driver, WebDriverWait wait,
            String name, String phone, String desc, String balance) throws InterruptedException {
        WebElement nameF = wait.until(ExpectedConditions.presenceOfElementLocated(
            By.xpath("//input[@name='customer_name']")));
        nameF.clear();
        if (name != null) nameF.sendKeys(name);
        System.out.println("  ✓ Name: " + (name == null || name.isEmpty() ? "[EMPTY]" : name));

        WebElement phoneF = driver.findElement(By.xpath("//input[@name='customer_phone']"));
        phoneF.clear();
        if (phone != null) phoneF.sendKeys(phone);
        System.out.println("  ✓ Phone: " + (phone == null || phone.isEmpty() ? "[EMPTY]" : phone));

        WebElement descF = driver.findElement(By.xpath("//textarea[@name='customer_desc']"));
        descF.clear();
        if (desc != null) descF.sendKeys(desc);

        WebElement balF = driver.findElement(By.xpath("//input[@name='customer_balance']"));
        balF.clear();
        if (balance != null) balF.sendKeys(balance);
        System.out.println("  ✓ Balance: " + (balance == null ? "[EMPTY]" : balance));

        driver.findElement(By.xpath("//button[@name='addRecord' and contains(text(),'Add')]")).click();
        Thread.sleep(3000);
        System.out.println("✓ Submitted Add form");
    }

    /** Reload customers page and wait for table */
    private void reloadCustomers(WebDriver driver, WebDriverWait wait) throws InterruptedException {
        driver.get(BASE_URL + "?page=customers");
        wait.until(ExpectedConditions.presenceOfElementLocated(
            By.xpath("//h3[contains(text(),'Customers')]")));
        wait.until(ExpectedConditions.presenceOfElementLocated(By.tagName("table")));
        Thread.sleep(2000);
    }

    /** Check if any table row contains the given text */
    private boolean rowExists(WebDriver driver, String text) {
        List<WebElement> rows = driver.findElements(By.xpath("//table//tbody//tr"));
        for (WebElement row : rows) {
            if (row.getText().contains(text)) return true;
        }
        return false;
    }

    /** Click the row link for the customer matching text; returns true if found */
    private boolean clickCustomerRow(WebDriver driver, String text) {
        List<WebElement> rows = driver.findElements(By.xpath("//table//tbody//tr"));
        for (WebElement row : rows) {
            if (row.getText().contains(text)) {
                try {
                    row.findElement(By.tagName("a")).click();
                    System.out.println("✓ Clicked customer row: " + text);
                    return true;
                } catch (Exception ignored) {}
            }
        }
        return false;
    }

    /**
     * Find customer by identifier; if not found, create one with the given defaults
     * then click into the customer profile.
     */
    private void findOrCreate(WebDriver driver, WebDriverWait wait,
            String findBy, String name, String phone, String desc, String balance)
            throws InterruptedException {
        if (!clickCustomerRow(driver, findBy)) {
            System.out.println("'" + findBy + "' not found — creating...");
            clickNew(driver, wait);
            fillAndSubmitCustomer(driver, wait, name, phone, desc, balance);
            reloadCustomers(driver, wait);
            clickCustomerRow(driver, findBy);
        }
        wait.until(ExpectedConditions.presenceOfElementLocated(
            By.xpath("//h3[contains(text(),'View Customer')]")));
        Thread.sleep(2000);
    }

    /** Click Update, wait for update form */
    private void clickUpdate(WebDriver driver, WebDriverWait wait) throws InterruptedException {
        wait.until(ExpectedConditions.elementToBeClickable(
            By.xpath("//a[contains(text(),'Update') or contains(@href,'update')]"))).click();
        Thread.sleep(2000);
        System.out.println("✓ Clicked Update");
    }

    /** Click Save */
    private void clickSave(WebDriver driver) throws InterruptedException {
        driver.findElement(
            By.xpath("//button[contains(text(),'Save') or contains(@name,'update')]")).click();
        Thread.sleep(3000);
        System.out.println("✓ Clicked Save");
    }

    /** Verify success message or assume success */
    private void verifySuccess(WebDriver driver) {
        try {
            WebElement msg = driver.findElement(
                By.xpath("//div[contains(@class,'alert-success')]"));
            if (msg.isDisplayed())
                System.out.println("✓ Success: " + msg.getText());
        } catch (Exception e) {
            System.out.println("✓ Update successful (no alert shown)");
        }
    }

    /** Get the DataTables search input */
    private WebElement getSearchInput(WebDriver driver, WebDriverWait wait) {
        String[] xpaths = {
            "//input[@type='search' and contains(@class,'dataTables_filter')]",
            "//div[@id='example1_filter']//input[@type='search']",
            "//input[@type='search']",
            "//input[@type='text' and contains(@placeholder,'Search')]"
        };
        for (String xp : xpaths) {
            try { return wait.until(ExpectedConditions.presenceOfElementLocated(By.xpath(xp))); }
            catch (Exception ignored) {}
        }
        return null;
    }

    private String capitalize(String s) {
        return s.isEmpty() ? s : Character.toUpperCase(s.charAt(0)) + s.substring(1);
    }

