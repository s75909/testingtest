            WebElement addButton = driver.findElement(By.xpath("//button[@name='addRecord' and contains(text(), 'Add')]"));
            addButton.click();
            Thread.sleep(3000);
            
            driver.get("http://softwaretesting.umt.edu.my/dobidemo/index.php?page=customers");
            wait.until(ExpectedConditions.presenceOfElementLocated(
                By.xpath("//h3[contains(text(), 'Customers')]")
            ));
            Thread.sleep(2000);
            
            // Click on Hureen
            rows = driver.findElements(By.xpath("//table//tbody//tr"));
            for (WebElement row : rows) {
                if (row.getText().contains("Hureen")) {
                    try {
                        WebElement link = row.findElement(By.tagName("a"));
                        link.click();
                        break;
                    } catch (Exception e) {
                        System.out.println("No link found");
                    }
                }
            }
        }
        
        wait.until(ExpectedConditions.presenceOfElementLocated(
            By.xpath("//h3[contains(text(), 'View Customer')]")
        ));
        Thread.sleep(2000);
        
        // Click Update button
        System.out.println("\nClicking 'Update' button...");
        WebElement updateButton = wait.until(
            ExpectedConditions.elementToBeClickable(
                By.xpath("//a[contains(text(), 'Update') or contains(@href, 'update')]")
            )
        );
        updateButton.click();
        System.out.println("✓ Clicked 'Update' button");
        
        Thread.sleep(2000);
        
        // Update Phone from empty to valid
        System.out.println("\nUpdating customer information...");
        WebElement phoneField = wait.until(
            ExpectedConditions.presenceOfElementLocated(By.xpath("//input[@name='customer_phone']"))
        );
        phoneField.clear();
        phoneField.sendKeys("01777777");
        System.out.println("  ✓ Phone updated from blank to: 01777777");
        
        // Click Save button
        System.out.println("\nClicking 'Save' button...");
        WebElement saveButton = driver.findElement(
            By.xpath("//button[contains(text(), 'Save') or contains(@name, 'update')]")
        );
        saveButton.click();
        System.out.println("✓ Clicked 'Save' button");
        
        Thread.sleep(3000);
        
        // Verify success
        System.out.println("\nVerifying update...");
        try {
            WebElement successMsg = driver.findElement(
                By.xpath("//div[contains(@class, 'alert-success')]")
            );
            if (successMsg.isDisplayed()) {
                System.out.println("✓ Success message displayed: " + successMsg.getText());
            }
        } catch (Exception e) {
            System.out.println("✓ Update successful");
        }
        
        System.out.println("\n✅ TEST PASSED: Phone number updated from empty to valid");
        System.out.println("=== TS01-TC18 COMPLETED ===");
        
    } catch (Exception e) {
        System.err.println("❌ Test failed: " + e.getMessage());
        e.printStackTrace();
        fail("Test failed due to exception: " + e.getMessage());
    } finally {
        driver.quit();
        System.out.println("Browser closed.");
