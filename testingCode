        WebElement table = wait.until(
            ExpectedConditions.presenceOfElementLocated(By.tagName("table"))
        );
        assertTrue(table.isDisplayed(), "Customer table should be displayed");
        System.out.println("✓ Customer table is displayed");
        
        // Verify table headers
        System.out.println("\nVerifying table headers...");
        List<WebElement> headers = driver.findElements(
            By.xpath("//table//thead//tr//th")
        );
        
        String[] expectedHeaders = {"Name", "Balance (RM)", "No. of Sales", "Category"};
        
        boolean allHeadersFound = true;
        for (String expectedHeader : expectedHeaders) {
            boolean found = false;
            for (WebElement header : headers) {
                if (header.getText().trim().equals(expectedHeader)) {
                    found = true;
                    System.out.println("  ✓ Found header: " + expectedHeader);
                    break;
                }
            }
            if (!found) {
                allHeadersFound = false;
                System.out.println("  ✗ Missing header: " + expectedHeader);
            }
        }
        
        assertTrue(allHeadersFound, "All expected headers should be present");
        System.out.println("✓ All table headers are present");
        
        // Verify table body has data
        System.out.println("\nVerifying customer data in table...");
        List<WebElement> tableRows = driver.findElements(
            By.xpath("//table//tbody//tr")
        );
        
        assertTrue(tableRows.size() > 0, "Table should have at least one customer record");
        System.out.println("✓ Number of customer records found: " + tableRows.size());
        
        // Verify each row has the required information (simplified check)
        System.out.println("\nVerifying customer information in each row...");
        int rowCount = 0;
        int rowsWithCompleteInfo = 0;
        
        for (WebElement row : tableRows) {
            rowCount++;
            String rowText = row.getText();
            
            // Check if row contains customer name (either with or without phone)
            boolean hasName = false;
            boolean hasBalance = false;
            boolean hasSales = false;
            boolean hasCategory = false;
            
            // Check for name (any text that's not just numbers)
            String[] lines = rowText.split("\n");
            for (String line : lines) {
                if (line.trim().length() > 0 && !line.trim().matches("\\d+.*") && !line.trim().matches(".*\\d+.*")) {
                    hasName = true;
                    break;
                }
            }
            // If no name found in separate lines, check the whole row text
            if (!hasName && rowText.matches(".*[A-Za-z].*")) {
                hasName = true;
            }
            
            // Check for balance (contains decimal number)
            if (rowText.matches(".*\\d+\\.\\d+.*") || rowText.contains("0.00") || rowText.contains("999,999.00")) {
                hasBalance = true;
            }
            
            // Check for sales count (single digit number)
            if (rowText.matches(".*\\b\\d+\\b.*")) {
                hasSales = true;
            }
            
            // Check for category (New, Regular, VIP, etc.)
            if (rowText.matches(".*(New|Regular|VIP|Gold|Silver|Bronze|Active|Inactive).*")) {
                hasCategory = true;
            }
            
            if (hasName && hasBalance && hasSales && hasCategory) {
                rowsWithCompleteInfo++;
                System.out.println("  ✓ Row " + rowCount + ": Complete information found");
            } else {
                System.out.println("  - Row " + rowCount + ": Partial information (Name:" + hasName + 
                    ", Balance:" + hasBalance + ", Sales:" + hasSales + ", Category:" + hasCategory + ")");
            }
        }
        
        // Verify at least some rows have complete information
        assertTrue(rowsWithCompleteInfo > 0, "At least one row should have complete customer information");
        System.out.println("✓ " + rowsWithCompleteInfo + " rows have complete customer information");
        
        // Verify specific customer information format
        System.out.println("\nVerifying customer information format...");
        boolean hasNameWithPhone = false;
        boolean hasBalanceWithRM = false;
        
        for (WebElement row : tableRows) {
            String rowText = row.getText();
            
            // Check if name has phone number format (e.g., "Name\n012-345 6789")
            if (rowText.contains("\n") && rowText.matches(".*\\d{3}[-\\s]?\\d{3}[-\\s]?\\d{4}.*")) {
                hasNameWithPhone = true;
                System.out.println("  ✓ Customer name with phone number format found");
            }
            
            // Check if balance has RM format
            if (rowText.contains("RM") || rowText.matches(".*\\d+\\.\\d+.*")) {
                hasBalanceWithRM = true;
                System.out.println("  ✓ Balance format found");
            }
        }
        
        // Get total customer count
