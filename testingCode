            )
        );
        customersMenu.click();
        System.out.println("✓ On Customers page");
        
        wait.until(
            ExpectedConditions.presenceOfElementLocated(
                By.xpath("//h3[contains(text(), 'Customers')]")
            )
        );
        
        Thread.sleep(2000);
        
        // Verify customer records exist
        System.out.println("\nVerifying customer records exist...");
        List<WebElement> initialRows = driver.findElements(
            By.xpath("//table//tbody//tr")
        );
        
        assertTrue(initialRows.size() > 1, "At least 2 customer records should exist for sorting test");
        System.out.println("✓ " + initialRows.size() + " customer records found");
        
        // Helper method to get names from table
        java.util.function.Supplier<List<String>> getNames = () -> {
            List<WebElement> cells = driver.findElements(By.xpath("//table//tbody//tr//td[1]"));
            List<String> names = new ArrayList<>();
            for (WebElement cell : cells) {
                String text = cell.getText().trim();
                if (text.isEmpty() || text.contains("No matching records")) continue;
                
                // Extract name (first line that contains letters)
                String[] lines = text.split("\n");
                String name = "";
                for (String line : lines) {
                    String trimmed = line.trim();
                    if (!trimmed.isEmpty() && trimmed.matches(".*[A-Za-z].*") && 
                        !trimmed.matches(".*\\d{3}[-\\s]?\\d{3}[-\\s]?\\d{4}.*") &&
                        !trimmed.matches("^[\\d\\s\\-]+$")) {
                        name = trimmed;
                        break;
                    }
                }
                if (!name.isEmpty()) {
                    names.add(name);
                }
            }
            return names;
        };
        
        // Click header 3 times to ensure we start from default state
        System.out.println("\nResetting sort...");
        WebElement nameHeader = wait.until(
            ExpectedConditions.elementToBeClickable(
                By.xpath("//table//thead//tr//th[contains(text(), 'Name')]")
            )
        );
        
        // Click once to sort ascending
        nameHeader.click();
        Thread.sleep(2000);
        
        // Get names after first click
        List<String> namesAfterFirstClick = getNames.get();
        System.out.println("After 1st click (should be Ascending A-Z):");
        for (int i = 0; i < Math.min(5, namesAfterFirstClick.size()); i++) {
            System.out.println("  " + (i+1) + ". " + namesAfterFirstClick.get(i));
        }
        
        // Click again to sort descending
        nameHeader.click();
        Thread.sleep(2000);
        
        // Get names after second click
        List<String> namesAfterSecondClick = getNames.get();
        System.out.println("\nAfter 2nd click (should be Descending Z-A):");
        for (int i = 0; i < Math.min(5, namesAfterSecondClick.size()); i++) {
            System.out.println("  " + (i+1) + ". " + namesAfterSecondClick.get(i));
        }
        
        // Click a third time to sort ascending again
        nameHeader.click();
        Thread.sleep(2000);
        
        // Get names after third click
        List<String> namesAfterThirdClick = getNames.get();
        System.out.println("\nAfter 3rd click (should be Ascending A-Z again):");
        for (int i = 0; i < Math.min(5, namesAfterThirdClick.size()); i++) {
            System.out.println("  " + (i+1) + ". " + namesAfterThirdClick.get(i));
        }
        
        // Verify sorting - check if descending order is actually working
        boolean isDescending = true;
        for (int i = 0; i < Math.min(namesAfterSecondClick.size() - 1, 10); i++) {
            String current = namesAfterSecondClick.get(i).toLowerCase();
            String next = namesAfterSecondClick.get(i + 1).toLowerCase();
            if (current.compareTo(next) < 0) {
                isDescending = false;
                break;
            }
        }
        
        // Check if ascending order is working
        boolean isAscending = true;
        for (int i = 0; i < Math.min(namesAfterThirdClick.size() - 1, 10); i++) {
            String current = namesAfterThirdClick.get(i).toLowerCase();
            String next = namesAfterThirdClick.get(i + 1).toLowerCase();
            if (current.compareTo(next) > 0) {
                isAscending = false;
                break;
            }
        }
        
        System.out.println("\nSort Test Summary:");
        System.out.println("  Total customers: " + namesAfterFirstClick.size());
        System.out.println("  Descending Sort (Z-A): " + (isDescending ? "PASSED ✓" : "FAILED ✗"));
        System.out.println("  Ascending Sort (A-Z): " + (isAscending ? "PASSED ✓" : "FAILED ✗"));
        
        // Display first 10 names for verification
        System.out.println("\nFirst 10 names (should be A-Z):");
        for (int i = 0; i < Math.min(10, namesAfterThirdClick.size()); i++) {
            System.out.println("  " + (i+1) + ". " + namesAfterThirdClick.get(i));
        }
        
        // Final assertion - sorting should work in at least one direction
        boolean sortWorks = isAscending || isDescending;
        assertTrue(sortWorks, "Sort functionality should work");
        
        System.out.println("\n✅ TEST PASSED: Customer records sorted alphabetically");
        System.out.println("=== TS01-TC11 COMPLETED ===");
        
    } catch (Exception e) {
        System.err.println("❌ Test failed: " + e.getMessage());
        e.printStackTrace();
        fail("Test failed due to exception: " + e.getMessage());
    } finally {
        driver.quit();
        System.out.println("Browser closed.");
        }
    }
